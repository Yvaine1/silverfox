            <name>BUILDACTION</name>
            <archiveVersion>2</archiveVersion>
            <data>
                <buildActions>
                    <buildAction>
                        <cmdline>cmd.exe /c copy "$TARGET_PATH$" "$PROJ_DIR$\..\Images\" &amp;&amp; echo &gt; "$BUILD_FILES_DIR$/.postbuild"</cmdline>
                        <workingDirectory>$PROJ_DIR$</workingDirectory>
                        <buildSequence>postLink</buildSequence>
                        <outputs>
                            <file>
                                <name>$BUILD_FILES_DIR$/.postbuild</name>
                            </file>
                        </outputs>
                    </buildAction>
                    <buildAction>
                        <cmdline>python  $PROJ_DIR$\..\Tools\bin_trim.py -i $PROJ_DIR$\Debug\Exe\CR5_1.bin -o $PROJ_DIR$\Debug\Exe\CR51.bin --offset 0x10000 --length 0x10ff0000</cmdline>
                        <workingDirectory>$PROJ_DIR$</workingDirectory>
                        <buildSequence>postLink</buildSequence>
                    </buildAction>
                    <buildAction>
                        <cmdline>python "$PROJ_DIR$\..\Tools\parse_iar_map.py" "$PROJ_DIR$\Debug\Exe\CR5_1.out" "$PROJ_DIR$\Debug\List\CR5_1.map" "$PROJ_DIR$\generated\CR5_1_out.txt" "$PROJ_DIR$\generated\CR5_1_map.txt" "$PROJ_DIR$\generated\symbol_table.c"</cmdline>
                        <workingDirectory>$PROJ_DIR$</workingDirectory>
                        <buildSequence>postLink</buildSequence>
                    </buildAction>
                </buildActions>
            </data>
        </settings>
