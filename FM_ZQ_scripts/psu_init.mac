__var CRF_APB;
__var DDR4_CTL_BASEADDR;
__var DDR4_PUB_BASEADDR;

__var CRF_WPROT;
__var RST_DDR_SS;

__var UctWriteProtShadow;
__var DctWriteOnly;
__var DctWriteProt;
__var UctWriteOnlyShadow;
__var UctDatWriteOnlyShadow;
__var CALBUSY;

__var HDTCTRL_VAL;
__var FIRMWARE_DEPTH;

__var PSU_INIT_SUCCESS;
__var PSU_INIT_FAIL;
__var PSU_INIT_TIMEOUT;

__var PSU_MASK_POLL_TIME;

load_define()
{
    HDTCTRL_VAL            = 0xff;
    
    CRF_APB               = 0xFD1A0000;
    DDR4_CTL_BASEADDR     = 0xFD070000;
    DDR4_PUB_BASEADDR     = 0xF4000000;
    
    CRF_WPROT             = 0x1C;
    RST_DDR_SS            = 0x108;
    
    UctWriteProtShadow    = 0x340010;
    DctWriteOnly          = 0x3400C0;
    DctWriteProt          = 0x3400C4;
   UctWriteOnlyShadow    = 0x3400C8;
   UctDatWriteOnlyShadow = 0x3400D0;
    CALBUSY               = 0x8025C;
    
    PSU_INIT_SUCCESS     = 0U;
    PSU_INIT_FAIL        = 1U;
    PSU_INIT_TIMEOUT     = 2U;
    
    PSU_MASK_POLL_TIME   = 100000000;
}

load_ddr_firmware()
{
    /* ddr3_firmware.hex or ddr4_firmware.hex */
    __memoryRestore("Memory", "$PROJ_DIR$\\..\\FM_ZQ_scripts\\ddr4_firmware.hex", 0);
}
mask_pollOnValue(addr, mask, val)
{
    __var value;
    __var i;
    
    i = 0;
    do {
        value = __readMemory32(addr, "Memory");
        if(i == PSU_MASK_POLL_TIME) {
            return PSU_INIT_TIMEOUT;
        }
        i++;
    }while((value & mask) != val);
    
   return 0;
}

mask_poll(addr, mask)
{
    __var value;
    __var i;
    
    i = 0;
   do {
        value = __readMemory32(addr, "Memory");
        if(i == PSU_MASK_POLL_TIME) {
            return PSU_INIT_TIMEOUT;
        }
        i++;
    }while((value & mask) == 0);
    
    return 0;
}

mask_delay(msec)
{
    __delay(msec);
    return;
}

PSU_Write(addr, val)
{
    __writeMemory32(val, addr, "Memory");
}

PSU_Mask_Write(addr, mask, val)
{
    __var value;
    
    value = __readMemory32(addr, "Memory");
    value = (val & mask) | (value & ~mask);
    __writeMemory32(value, addr, "Memory");
}

PSU_WriteReg(addr, offset, val)
{    
    __writeMemory32(val, addr+offset, "Memory");
}

PSU_WritePubReg(addr, offset, val)
{    
    __writeMemory32(val, addr+(offset*4), "Memory");
}

PSU_Read(addr)
{
    __var val;
    
    val = __readMemory32(addr, "Memory");
    
    return val;
}

PSU_Mask_Read(addr, mask)
{
    __var val;
    
    value = __readMemory32(addr, "Memory");
    
    val = (value & mask);
    
    return val;
}

PSU_ReadReg(addr, offset)
{
    __var val;
    
    val = __readMemory32(addr+offset, "Memory");
    
    return val;
}

PSU_Mask_Copy(addrsrc, addrdst, masksrc, maskdst)
{
    __var value_src, value_dst;
    __var srclow, dstlow;
    
    value_src = __readMemory32(addrsrc, "Memory");
    value_dst = __readMemory32(addrdst, "Memory");
    
    value_src = value_src & masksrc;
    srclow = 0;
    while (!(masksrc & 1)) { masksrc >>= 1; ++srclow; };
    dstlow = 0;
    while (!(maskdst & 1)) { maskdst >>= 1; ++dstlow; };
    value_src = (value_src >> srclow) << dstlow;    
    value_dst = (value_src & maskdst) | (value_dst & ~maskdst);
    __writeMemory32(value_dst, addrdst, "Memory");              
}

/****************************************************************************/
/** DDR initialize **/

get_mail(mode)
{
    __var ret;
    __var mail;
    
    //1.Poll the UctWriteProtShadow, looking for a 0
    ret = mask_pollOnValue(DDR4_PUB_BASEADDR + UctWriteProtShadow, 0x1, 0x0);
    if(ret)
        return PSU_INIT_TIMEOUT;
        
    //2.get  major message number
    mail = PSU_ReadReg(DDR4_PUB_BASEADDR, UctWriteOnlyShadow);
    
    //2.get streaming message
    if(mode==1) {
        mail |= (PSU_ReadReg(DDR4_PUB_BASEADDR, UctDatWriteOnlyShadow)) << 16;
    }
    
    //3. acknowledge the receipt of the message 
    PSU_WriteReg(DDR4_PUB_BASEADDR, DctWriteProt, 0x0);  
    
    //4.Poll the UctWriteProtShadow, looking for a 1
    ret = mask_pollOnValue(DDR4_PUB_BASEADDR + UctWriteProtShadow, 0x1, 0x1);
    if(ret)
        return PSU_INIT_TIMEOUT;
        
    //5.When a 1 is seen, write the DctWriteProt to 1 to complete the protocol
    PSU_WriteReg(DDR4_PUB_BASEADDR, DctWriteProt, 0x1);
    
    return mail;
}
ddr_initial()
{
    //add your's code here
    __var ret, i;
    __var major,string_index;
    __var message_buf;
    __var init_done_flag;
    __var status,temp;
    __var ECC_Enable;
    __var Effective_DRAM_BUS_Width;

    major=0;
    string_index=0;

    PSU_WriteReg(CRF_APB, CRF_WPROT, 0x0);     //FPD_ACTIVE

    __message "Step2: Program the DDRC registers!";
    PSU_WriteReg(CRF_APB, RST_DDR_SS, 0xF8);
    mask_delay(10);

    PSU_WriteReg(CRF_APB, RST_DDR_SS, 0xC8);//release PUB/Controller APB reset
    mask_delay(10);
    // Config controller data
    ddr_controller_init_data();

    __message "Step3: release Core reset!";
    PSU_WriteReg(CRF_APB, RST_DDR_SS, 0x00);
    mask_delay(10);


    __message "Step4: Disable auto-refreshes,self-refresh,powerdown and assertion of dfi_dram_clk_disable!";
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000304, 0x00000000);
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000304, 0x00000000);
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000060, 0x00000001); // Disbale auto-refreshes
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000030, 0x00000000); // self-refresh,powerdown, assertion of dfi_dram_clk_disable
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000000);
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000001b0, 0x00000050); //Set DFIMISC.dfi_init_complete_en to 0

    __message "Step7: Set SWCTL.sw_done to 1,Polling SWSTAT.sw_done_ack!";
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000001);
    ret = mask_pollOnValue(DDR4_CTL_BASEADDR + 0x00000324, 0x1, 0x1);
    if(ret)
        return PSU_INIT_TIMEOUT;

    __message "Step8::Start PHY initialization and training by accessing relevant PUB registers!";
    __message "Step8: PHY training:Step (C) Initialize PHY Configuration!";
    __message "Step8: PHY training:Step (D) Load IMEM Memory!";
    ddr_pub_init_data_0();

    __message "Step8: PHY training:Step (G)Execute the Training Firmware!";
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0000, 0x1);
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0099, 0x9);
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0099, 0x1);
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0099, 0x0);

    __message "Step8: PHY training:Step (H)Read the Message Block results!";
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0x0002006e,0x0);
    while((major != 0x7) && (major != 0xff))  {
        major = get_mail(0);
        if(major == 8){
            string_index  = get_mail(1);
            for(i=0; i< (string_index & 0xffff);i++) {
                message_buf[i] = get_mail(1);
            }
        }
    }

    if(major == 0xff){
        __message "DDR training failed!";
        return PSU_INIT_FAIL;
    }
    else{
        __message "DDR training successfully!";
    }

    // mask_delaying for caldone
    ret = mask_pollOnValue(DDR4_PUB_BASEADDR + CALBUSY, 0xffffffff, 0x0);
    if(ret)
        return PSU_INIT_TIMEOUT;

    __message "Step8: PHY training End!";
    __message "Step8: Stop MCU Control!";
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0099, 0x1);
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0000, 0x0);
    PSU_WritePubReg(DDR4_PUB_BASEADDR, 0xd0000, 0x1);

    __message "Step8: PHY training(I) Load PHY Init Engine Image!";
    ddr_pub_init_data_1();

    __message "Step17: Polling SWSTAT.sw_done= 0x1 after setting SWCTL.sw_done to '0'";
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000000); //step15 Set SWCTL.sw_done to '0'
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000001b0, 0x00000070); //step16 Set DFIMISC.dfi_init_start to 1
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000001); //step17 Set SWCTL.sw_done to '1'

    //Step18 Poll DFISTAT.dfi_init_complete=1
    ret = mask_pollOnValue(DDR4_CTL_BASEADDR + 0x000001bc, 0x1, 0x1);
    if(ret)
        return PSU_INIT_TIMEOUT;

    __message "Step19: Polling SWSTAT.sw_done_ack= 0x1 aftersetting SWCTL.sw_done to '0'";
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000000);//step19 Set SWCTL.sw_done to '0'
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000001b0, 0x00000050);//step20 Set DFIMISC.dfi_init_start to 0
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000001b0, 0x00000051);//step22 Set DFIMISC.dfi_init_complete_en to 1
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000030, 0x00000000); //step23 Set PWRCTL.selfref_sw to 0

    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000320, 0x00000001);//step24 Set SWCTL.sw_done to '1'

    //poll status,SWSTAT.sw_done_ack =1
    ret = mask_pollOnValue(DDR4_CTL_BASEADDR + 0x00000324, 0x1, 0x1);
    if(ret)
        return PSU_INIT_TIMEOUT;

    //poll ddrc operating_mode = normal status
    //000 - Init
    //001 - Normal
    //010 - Power-down
    //011 - Self-refresh
    //1XX - Deep power-down/Maximum Power Saving Mode
    ret = mask_pollOnValue(DDR4_CTL_BASEADDR + 0x00000004, 0x7, 0x1);
    if(ret)
        return PSU_INIT_TIMEOUT;

    __message "Step21: Set registers may need to be updated after training has completed!";
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000060, 0x00000000); // Enable auto-refreshes
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000030, 0x00000000); // Disable self-refresh,powerdown, assertion of dfi_dram_clk_disable

    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000490, 0x00000001); // Enable port0
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000540, 0x00000001); // Enable port1
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000005f0, 0x00000001); // Enable port2
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000006a0, 0x00000001); // Enable port3
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000750, 0x00000001); // Enable port4
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x00000800, 0x00000001); // Enable port5
    PSU_WriteReg(DDR4_CTL_BASEADDR, 0x000008b0, 0x00000001); // Enable port6

    ECC_Enable = 0;
    Effective_DRAM_BUS_Width = 64;
    //Enable ECC Scrub
    if(ECC_Enable==1)
    {
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x490,0x0);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f2c,0x5a5a5a5a);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f30,0x5a5a5a5a);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f38,0x00000000);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f3C,0x0);
      if(Effective_DRAM_BUS_Width==64)
      {
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f40,((DDR_SIZE/8-1)&0xFFFFFFFF));
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f44,((DDR_SIZE/8-1)>>32)&0x7);  //DDR_SIZE/8
      }
      else if(Effective_DRAM_BUS_Width==32)
      {
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f40,((DDR_SIZE/4-1)&0xFFFFFFFF));
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f44,((DDR_SIZE/4-1)>>32)&0x7);  //DDR_SIZE/4
      }
      else
      {
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f40,((DDR_SIZE/2-1)&0xFFFFFFFF));
        PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f44,((DDR_SIZE/2-1)>>32)&0x7);  //DDR_SIZE/2
      }
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f24,0x4);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f24,0x7);

      init_done_flag=1;

      while(init_done_flag)
      {
        status = PSU_ReadReg(DDR4_CTL_BASEADDR,0xf28);
        temp=status&0x2;
        if(temp==0x2)
        {
          init_done_flag =0;
        }
      }
      
      init_done_flag=1;
      while(init_done_flag)
      {
        status = PSU_ReadReg(DDR4_CTL_BASEADDR,0xf28);
        temp=status&0x0;
        if(temp==0x0)
        {
          init_done_flag =0;
        }
      }
      
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f24,0x6);
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f24,0x2);
      
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x00000f24,0x103);
      
      PSU_WriteReg(DDR4_CTL_BASEADDR,0x490,0x1);
      
    }

    return PSU_INIT_SUCCESS;
}

