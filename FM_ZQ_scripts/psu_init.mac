    PSU_Mask_Write(0xfd615000, 0xc00000, 0x00800000U);
    // FPD_AXI_DW_SEL.S_AXI_HP0_FPD = 2(128 )
    PSU_Mask_Write(0xfd615000, 0x300000, 0x00200000U);
    // FPD_AXI_DW_SEL.S_AXI_HPC1_FPD = 2(128 )
    PSU_Mask_Write(0xfd615000, 0xc0000, 0x00080000U);
    // FPD_AXI_DW_SEL.S_AXI_HPC0_FPD = 2(128 )
    PSU_Mask_Write(0xfd615000, 0x30000, 0x00020000U);
    // FPD_AXI_DW_SEL.M_AXI_HPM1_FPD = 2(128 )
    PSU_Mask_Write(0xfd615000, 0xc, 0x00000008U);
    // FPD_AXI_DW_SEL.M_AXI_HPM0_FPD = 2(128 )
    PSU_Mask_Write(0xfd615000, 0x3, 0x00000002U);
    return PSU_INIT_SUCCESS;
}


/****************************************************************************/

psu_init()
{
  __var ret;
  
    ret = PSU_INIT_SUCCESS;
   
    __message "run psu_mio_init_data";
  ret |= psu_mio_init_data();   
  
    __message "run psu_peripherals_pre_init_data";
  ret |= psu_peripherals_pre_init_data();
  
    __message "run psu_pll_init_data";
  ret |= psu_pll_init_data();
  
    __message "run psu_clock_init_data";
  ret |= psu_clock_init_data();
  
    __message "run ddr_initial";
    __registerMacroFile("$PROJ_DIR$\\..\\FM_ZQ_scripts\\ddr_init_data.mac");
  ret |= ddr_initial();
  
    __message "run psu_peripherals_init_data";
  ret |= psu_peripherals_init_data();
  
    __message "run psu_peripherals_powerdwn_data";
  ret |= psu_peripherals_powerdwn_data();
  
    __message "run psu_afi_config";
  ret |= psu_afi_config();
  
    if(ret != PSU_INIT_SUCCESS)
        return ret;
        
  return PSU_INIT_SUCCESS;
}

