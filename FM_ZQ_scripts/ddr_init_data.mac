  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x2000b,0x4b); // 0.5*Memclk/8
  // // [phyinit_I_loadPIEImage] Pstate=0,  Memclk=1200MHz, Programming Seq0BDLY1 to 0xc8
  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x2000c,0x96); // 1* Memclk/8
  // // [phyinit_I_loadPIEImage] Pstate=0,  Memclk=1200MHz, Programming Seq0BDLY2 to 0x7d0
  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x2000d,0x5dc);// Memclk>400MHz: 10* Memclk/8 ; Memclk<=400MHz:0x10
  // // [phyinit_I_loadPIEImage] Pstate=0,  Memclk=1200MHz, Programming Seq0BDLY3 to 0x2c
  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x2000e,0x2c);// Memclk>533MHz: 0x2c ; Memclk<=533MHz:0x21
  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x9000c,0x0);
  PSU_WritePubReg(DDR4_PUB_BASEADDR,0x9000d,0x173);
