
/*********************************************************************
*
*       execUserProbeConnect()
*/
execUserProbeConnect()
{
    __message "------------------------------ execUserProbeConnect ---------------------------------";

    __var core_mask;
    
    /******************
    * core_mask
    * 0x1 : split core0
    * 0x2 : split core1
    * 0x4 : lock-step
    ******************/
    core_mask = 0x4;

    if(__driverType("jlink")){
        
        __var cmd;

        __registerMacroFile("$PROJ_DIR$\\..\\FM_ZQ_scripts\\init.mac");
        
        cmd = __expandVar("ScriptFile = $PROJ_DIR$\\..\\FM_ZQ_scripts\\j-link\\init.JLinkScript");
        __message "Jlink Exec Command ", cmd;
        __jlinkExecCommand(cmd);
    
        //__jlinkExecMacro("HwReset");
        //__delay(500);
        __jlinkExecMacro("IdentifyTarget");

        init_dap();
        
        select_apb_ap();
        rpu_halt(core_mask);
    
        select_axi_ap();  
        rpu_init(core_mask);
    }
}

