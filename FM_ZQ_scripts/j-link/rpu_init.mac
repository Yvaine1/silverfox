/*********************************************************************
*
*       execUserPreload()
*/
execUserPreload()
{
    __message "------------------------------ execUserPreload ---------------------------------";
     
    __var val;
    
    val= SCTLR;
    if(val & 0x1005) {
        __message "Disable SCTLR.M & SCTLR.C & SCTLR.I";
        val &= ~(0x1005);
        SCTLR = val;
        __message "SCTLR=0x",val:%x;
    }
    
    if(__isMacroSymbolDefined("psu_init")) {
        load_define();
        psu_init();
    }
}

/*********************************************************************
*
*       execUserSetup()
*/
execUserSetup()
{
    __message "------------------------------ execUserSetup -------------------------------------";
    
    rpu_copy_vectors();
}

