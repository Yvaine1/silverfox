void select_pmu(void)
{
    JLINK_SYS_Report("Select PMU");

    CORESIGHT_CoreBaseAddr = _APB_ADDR_DBGREGS_PMU_DBG_0;   
}

/**************************************************************/

void loop_code_high(void)
{
    U32 var;

    JLINK_SYS_Report("Set loop code at 0xFFFF0000.");

    //set 0xFFFF0000 = 0xEA000000
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0xFFFF0000);
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0xEA000000);
    //set 0xFFFF0004 = 0x14000000
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0xFFFF0004);
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0x14000000);
    //set 0xFFFF0008 = 0xEAFFFFFE
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, 0xFFFF0008);
    JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, 0xEAFFFFFE);
}

/****************************************************************/

int ConfigTargetSettings()
{
    JLINK_CORESIGHT_AddAP(0, CORESIGHT_AXI_AP);
    JLINK_CORESIGHT_AddAP(1, CORESIGHT_APB_AP);
    CORESIGHT_IndexAPBAPToUse = 1;

    return 0;
}

int InitTarget()
{
    CPU = CurrentCPU;
    JLINK_SYS_Report1("CPU is ", CurrentCPU);

    if(CurrentCPU == CORTEX_A53)
    {
        if(CoreId == 0) 
        {
            select_apu_core0();
        }
        else if(CoreId == 1) 
        {
            select_apu_core1();
        }
        else if(CoreId == 2) 
        {
            select_apu_core2();
        }
        else if(CoreId == 3) 
        {
            select_apu_core3();
        }
    }
    else if(CurrentCPU == CORTEX_R5) 
    {
        if(CoreId == 0) 
        {
            select_rpu_core0();
        }
        else if(CoreId == 1) 
        {
            select_rpu_core1();
        }
        else if(CoreId == 2) 
        {
            select_pmu();
        }
    }

    return 0;
}

int ResetTarget()
{    
    return 0;
}
