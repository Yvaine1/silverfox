/*********************************************************************
*
*       execUserPreload()
*/
execUserPreload()
{
    __message "------------------------------ execUserPreload -----------------------------------";
     
    __var val;
    
    val= SCTLR_EL3;
    if(val & 0x1005) {
        __message "Disable SCTLR_EL3.M & SCTLR_EL3.C & SCTLR_EL3.I";
        val &= ~(0x1005);
        SCTLR_EL3 = val;
        __message "SCTLR_EL3=0x",val:%x;
    }
    
    if(__isMacroSymbolDefined("psu_init")) {
        load_define();
        psu_init();
    }
}

