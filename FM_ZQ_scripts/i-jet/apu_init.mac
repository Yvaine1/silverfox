
/*********************************************************************
*
*       execUserCoreConnect()
*/
execUserCoreConnect()
{
    __message "------------------------------ execUserCoreConnect ---------------------------------";
    
    __var val, core_mask;
        
    /******************
    * core_mask
    * 0x1 : core0
    * 0x2 : core1
    * 0x4 : core2
    * 0x8 : core3
    ******************/
    core_mask = 0x1;
    
    if(__driverType("ijet")) {   
        
        if(__isMacroSymbolDefined("init_mac_loaded") == 0) {
            __registerMacroFile("$PROJ_DIR$\\..\\FM_ZQ_scripts\\init.mac");
        }

        init_dap();
        
        select_apb_ap();
        apu_halt(core_mask);
    
        select_axi_ap();  
        apu_init(core_mask);
    }
}

